# ---- Claude / Anthropic ----
# Ohne Key laeuft das System im Mock-Modus (deterministische Beispielantworten).
ANTHROPIC_API_KEY=

# ---- Server ----
PORT=4000
HOST=127.0.0.1

# ---- Vault ----
# Master-Passphrase fuer die Verschluesselung der Zugangsdaten (AES-256-GCM).
# Ohne diesen Wert koennen keine Secrets gespeichert oder gelesen werden.
VAULT_PASSPHRASE=

# ---- Ablage ----
# local  = Dateien liegen unter data/drive (Entwicklung / Test)
# gdrive = Google Drive via Service Account (Google Workspace)
STORAGE_DRIVER=local

# ---- Mail ----
# mock  = Mails landen in data/outbox als .eml (Entwicklung / Test)
# gmail = Versand ueber Gmail API mit demselben Service Account
MAIL_DRIVER=mock

# ---- Portal-Anmeldung ----
# 0 = Browser laeuft unsichtbar (nur fuer Tests sinnvoll - du sollst im Fenster
# arbeiten koennen)
BROWSER_SICHTBAR=1
# CHROME_PROFIL_DIR=./data/chrome-profil
# CHROME_EXECUTABLE=

# ---- Google (fuer STORAGE_DRIVER=gdrive und MAIL_DRIVER=gmail) ----
# Pfad zum JSON-Schluessel des Service Accounts. Diese Datei enthaelt einen
# privaten Schluessel - nicht ins Repository legen (secrets/ ist ignoriert).
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
# Postfach, in dessen Namen der Service Account handelt (domainweite Delegierung)
GOOGLE_IMPERSONATE_USER=accounting@lexaid.net
# ID des Drive-Zielordners - steht in der Adresszeile hinter /folders/
DRIVE_ROOT_FOLDER_ID=
# Einrichtung pruefen mit: npm run google:check
MAIL_FROM=accounting@lexaid.net
ACCOUNTING_INBOX=accounting@lexaid.net
SHORTCODE_DOMAIN=lexaid.net
